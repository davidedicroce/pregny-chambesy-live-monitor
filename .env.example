# Pregny-Chambesy, canton Geneva, Switzerland (approximate single forecast point)
MONITOR_LAT=46.2408
MONITOR_LON=6.14226
AREA_NAME="Pregny-Chambesy, Geneva, Switzerland"

# Start in NO-SEND mode. For a *private test group* only, enable 0 with permission.
DRY_RUN=1
LIVE_ALERTS_AUTHORIZED=NO
SIGNAL_ACCOUNT=+41XXXXXXXXX
# Set exactly ONE recipient: a group ID, or a Signal username for personal tests.
SIGNAL_GROUP_ID=REPLACE_WITH_GROUP_ID
SIGNAL_USERNAME=

# This MVP uses 3h weather outlooks, USGS recent earthquake reports.
WEATHER_POLL_SECONDS=600
QUAKE_POLL_SECONDS=60
FORECAST_HOURS=3

# EXPERIMENTAL ONLY — unvalidated local thresholds; tune before any operational use.
RAIN_3H_MM=25
RAIN_3H_HIGH_MM=40
GUST_KMH=75
GUST_HIGH_KMH=95
HEAT_C=34
HEAT_HIGH_C=38
COLD_C=-8
COLD_HIGH_C=-12
QUAKE_MIN_MAG=3.5
QUAKE_HIGH_MAG=4.5
QUAKE_MAX_KM=80
QUAKE_MAX_AGE_MINUTES=120

# A weather episode ends only after the hazard is absent this long (stops repeat alerts
# when a forecast hovers around a threshold). 0 = end at the first clear check.
WEATHER_CLEAR_MINUTES=60

# Send a "monitoring gap" notice when a data source has failed for this long (min 15).
STALE_SOURCE_MINUTES=60

# Delete stored forecast snapshots older than this; 0 = keep forever.
SNAPSHOT_RETENTION_DAYS=90

# Volunteer duty hours (Europe/Zurich): weekdays DUTY_START_HOUR-DUTY_END_HOUR, plus
# weekends and Geneva public holidays all day. Hazards entirely outside duty hours are
# not reported. DUTY_HOURS_ONLY=0 reports everything.
DUTY_HOURS_ONLY=1
DUTY_START_HOUR=19
DUTY_END_HOUR=6

# Optional, default: monitor.sqlite3 in this directory
# DB_PATH=/path/to/monitor.sqlite3
